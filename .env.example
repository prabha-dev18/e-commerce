NEXT_PUBLIC_SITE_NAME=Lumière
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# Database: local MongoDB or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/lumiere

# NextAuth (generate a secret: openssl rand -base64 32)
NEXTAUTH_SECRET=change-me-to-a-long-random-string
NEXTAUTH_URL=http://localhost:3000
# Optional Google login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Seed (npm run seed, with the dev server running)
SEED_SECRET=change-me-seed-secret
ADMIN_EMAIL=admin@lumiere.in
ADMIN_PASSWORD=ChangeMe@123

# Email (optional in dev: links are printed in the server console when empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Lumière <care@lumiere.in>"

NEXT_PUBLIC_GOOGLE_ENABLED=false

# Razorpay (Phase 5). Use test keys first: Razorpay dashboard > Account & Settings > API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Image uploads in the admin (optional): cloudinary.com > Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# QR code payments (UPI)
# Option A (automatic confirmation): add Razorpay keys above and enable the webhook event "qr_code.credited".
# Option B (no Razorpay): put your own UPI id here. The customer scans, pays and enters the UTR; you confirm it in Admin > Orders.
UPI_VPA=
UPI_PAYEE_NAME=Lumiere

# Printed on invoices (optional)
STORE_ADDRESS=
STORE_GSTIN=
STORE_STATE=Gujarat
